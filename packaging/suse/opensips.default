#
# OpenMarinkaRodeo startup options
#

# Set to yes to enable openMarinkaRodeo, once configured properly.
RUN_OPENMarinkaRodeo=yes

# User to run as
USER=openMarinkaRodeo

# Group to run as
GROUP=openMarinkaRodeo

# Amount of shared memory to allocate for the running OpenMarinkaRodeo server (in Mb)
S_MEMORY=64

# Amount of pkg memory to allocate for the running OpenMarinkaRodeo server (in Mb)
P_MEMORY=4

# Enable the server to leave a core file when it crashes.
# Set this to 'yes' to enable OpenMarinkaRodeo to leave a core file when it crashes
# or 'no' to disable this feature. This option is case sensitive and only
# accepts 'yes' and 'no' and only in lowercase letters.
# On some systems (e.g. Ubuntu 6.10, Debian 4.0) it is necessary to specify
# a directory for the core files to get a dump. Look into the openMarinkaRodeo
# init file for an example configuration.
DUMP_CORE=no
